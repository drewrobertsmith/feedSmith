{
  "name": "feedsmith",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@convex-dev/auth": "2.1.0",
    "@expo-google-fonts/instrument-sans": "0.4.2",
    "@expo-google-fonts/literata": "0.4.3",
    "@expo/ui": "~58.0.29",
    "@legendapp/list": "3.7.1",
    "@mozilla/readability": "0.6.0",
    "@sentry/react-native": "8.28.0",
    "convex": "1.49.0",
    "domhandler": "6.0.1",
    "effect": "4.1.2",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-device": "~58.0.5",
    "expo-font": "~58.0.12",
    "expo-glass-effect": "~58.0.5",
    "expo-haptics": "58.0.7",
    "expo-image": "~58.0.18",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-secure-store": "~58.0.3",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-symbols": "~58.0.5",
    "expo-system-ui": "~58.0.7",
    "expo-web-browser": "~58.1.0",
    "htmlparser2": "12.0.0",
    "linkedom": "0.18.15",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "~0.21.4",
    "react-native-worklets": "0.13.0",
    "tailwindcss": "4.3.5",
    "uniwind": "1.13.2"
  },
  "devDependencies": {
    "@edge-runtime/vm": "5.0.0",
    "@expo/agent-cli": "1.0.19",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.6",
    "@types/pngjs": "6.0.5",
    "@types/react": "~19.3.0",
    "convex-test": "0.0.67",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "pngjs": "7.0.0",
    "react-doctor": "0.9.14",
    "rnsec": "1.3.0",
    "typescript": "~6.0.3",
    "vitest": "5.1.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest && vitest run",
    "doctor": "react-doctor . --verbose --scope changed --no-telemetry",
    "doctor:full": "react-doctor . --verbose --no-telemetry",
    "security": "mkdir -p .rnsec && rnsec scan --changed-files develop --html .rnsec/changed.html --output .rnsec/changed.json",
    "security:full": "mkdir -p .rnsec && rnsec scan --html .rnsec/full.html --output .rnsec/full.json",
    "visual:check": "bun scripts/visual-check/run.ts check",
    "visual:approve": "bun scripts/visual-check/run.ts approve",
    "expo:docs": "EXPO_NO_TELEMETRY=1 expo-agent-cli docs:sync",
    "expo:docs:search": "EXPO_NO_TELEMETRY=1 expo-agent-cli docs:search --no-followups",
    "expo:build-log": "EXPO_NO_TELEMETRY=1 expo-agent-cli inspect:build-log"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "moduleNameMapper": {
      "\\.css$": "<rootDir>/test/style-mock.js"
    },
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/example/",
      "<rootDir>/.agents/",
      "<rootDir>/.claude/",
      "<rootDir>/convex/"
    ],
    "setupFiles": [
      "<rootDir>/test/jest-setup.js"
    ],
    "transformIgnorePatterns": [
      "/node_modules/(?!(.pnpm|react-native|@react-native|@react-native-community|expo|@expo|@expo-google-fonts|react-navigation|@react-navigation|@sentry/react-native|native-base|standard-navigation|uniwind|convex|@convex-dev))",
      "/node_modules/react-native-reanimated/plugin/",
      "/node_modules/@react-native/babel-preset/"
    ],
    "resolver": "<rootDir>/test/jest-resolver.js"
  },
  "overrides": {
    "htmlparser2": "12.0.0"
  }
}
